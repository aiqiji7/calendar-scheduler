# Calendar Scheduler 环境变量模板
#
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env
#
# 本文件中的值均为占位或默认值，不含任何真实凭据。

# 后端选择：graph / caldav
# 留空时自动推断：配置了 CALDAV_USERNAME 且未配置 AZURE_CLIENT_ID → caldav，否则 graph
CALENDAR_BACKEND=

# ============================================================
# 方式 A：Microsoft Graph（Outlook / 个人 Microsoft 账户）
# 在 Azure Portal 注册应用后填入；权限范围 Calendars.ReadWrite User.Read
# ============================================================
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# 个人 Microsoft 账号（outlook.com 等）：将 AZURE_TENANT_ID 设为 consumers，
# 或在下面显式指定完整 authority，如 https://login.microsoftonline.com/common
AAD_AUTHORITY=

# Graph API 版本，默认 v1.0
GRAPH_API_VERSION=v1.0

# ============================================================
# 方式 B：CalDAV（QQ 邮箱等）
# QQ 邮箱需先在网页端开启 CalDAV 服务并生成 16 位授权码：
#   设置 → 账户 → 「POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV 服务」→ 生成授权码
# CALDAV_PASSWORD 填授权码，不是 QQ 登录密码；修改 QQ 密码会使旧授权码失效
# ============================================================
CALDAV_BASE_URL=https://dav.qq.com
CALDAV_USERNAME=
CALDAV_PASSWORD=

# 目标日历的显示名或 href，留空自动选择
CALDAV_CALENDAR=

# 默认排除的日历（逗号分隔）
CALDAV_EXCLUDE_CALENDARS=Tasks,好友生日

# ============================================================
# 通用
# ============================================================
# 时区名：用于解释不带偏移的时间，并作为写入事件时的 timeZone（默认 Asia/Shanghai）
CALENDAR_TIME_ZONE=Asia/Shanghai
